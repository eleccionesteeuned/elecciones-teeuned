rules_version = '2';

// TEEUNED — Reglas de seguridad de Firestore
//
// UID de las dos cuentas de personal (TEEUNED y Fiscalía), creadas en
// Firebase Console > Authentication > Users. Se referencian directo aquí
// en vez de necesitar un backend con Admin SDK para roles dinámicos.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeeuned() {
      return request.auth != null && request.auth.uid == 'BoQ0s3unG2ZCd5k4nvWQnrzvvVB3';
    }
    function isFiscalia() {
      return request.auth != null && request.auth.uid == 'P2rcIbSk9sS3qWIOmtSSKfStAku1';
    }
    function isStaff() {
      return isTeeuned() || isFiscalia();
    }

    // Padrón: lectura pública (necesaria para resolver carnet -> correo
    // de autenticación ANTES de iniciar sesión). Solo nombre/carnet/correo
    // institucional, nada sensible. Escritura solo TEEUNED.
    match /padron/{carnet} {
      allow read: if true;
      allow write: if isTeeuned();
    }

    // Procesos de votación: resultados agregados visibles para todos los
    // autenticados (estudiantes, TEEUNED, Fiscalía). Crear/cerrar solo TEEUNED.
    match /procesos/{procesoId} {
      allow read: if request.auth != null;
      allow create, update: if isTeeuned();
      allow delete: if false;

      // Votos individuales: el ID del documento es el carnet del votante.
      // Solo se puede crear (nunca editar/borrar = inmutable) y SOLO si:
      //   1) hay sesión autenticada,
      //   2) el UID autenticado coincide con el authUid guardado en el
      //      padrón para ESE carnet (evita votar en nombre de otro),
      //   3) el carnet del voto coincide con el ID del documento,
      //   4) no existe ya un voto de ese carnet en este proceso (anti doble voto).
      // NOTA: la lectura de "votos" tiene que estar abierta a cualquier
      // autenticado (no solo isStaff()) porque la app calcula los conteos
      // agregados (a favor/en contra/etc.) en el navegador leyendo TODA la
      // subcolección — un estudiante no puede consultar únicamente su
      // propio documento y aun así ver los resultados del proceso. Esto
      // significa que el secreto del voto en procesos "cerrada"/"personas"
      // depende de que la UI no muestre el nombre (ya lo hace), NO de que
      // el dato sea inaccesible: alguien con la consola del navegador
      // podría leer voterName/voterCarnet igual. Cerrar ese hueco de
      // verdad requeriría agregar los resultados en un backend (Cloud
      // Function), fuera del alcance actual (100% cliente, plan gratuito).
      match /votos/{carnet} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/padron/$(carnet)).data.authUid == request.auth.uid
          && request.resource.data.voterCarnet == carnet
          && !exists(/databases/$(database)/documents/procesos/$(procesoId)/votos/$(carnet));
        allow update, delete: if false;
      }
    }

    // Catálogo de Sedes/Regiones para Votaciones AUR (Asamblea Universitaria
    // Representativa). Editable solo por TEEUNED; legible por cualquier
    // autenticado (lo usa el panel de administración para los formularios).
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isTeeuned();
    }

    // Votaciones AUR: una elección por Sede y una por Región. A diferencia
    // de /procesos, aquí la lectura NO está abierta a cualquier autenticado
    // — un estudiante solo puede leer (y por tanto solo llega a saber que
    // existen) las elecciones de SU sede y SU región, verificado con los
    // custom claims "sede"/"region" del token de Firebase Auth (asignados
    // por netlify/functions/set-student-scope.js al agregar/editar un
    // estudiante en el padrón — nunca por el cliente). TEEUNED/Fiscalía ven
    // todo, para poder administrar y supervisar cualquier sede/región.
    match /procesos_aur/{procesoId} {
      allow read: if isStaff() || (
        request.auth != null &&
        (resource.data.scope.name == request.auth.token.sede ||
         resource.data.scope.name == request.auth.token.region)
      );
      allow create, update: if isTeeuned();
      allow delete: if false;

      match /votos/{carnet} {
        // La lectura agregada (para calcular resultados) se limita a
        // quienes ya tienen acceso a la elección padre (mismo sede/región,
        // o personal) — a diferencia de /procesos/votos, que está abierto
        // a cualquier autenticado.
        allow read: if isStaff() || (
          request.auth != null &&
          (get(/databases/$(database)/documents/procesos_aur/$(procesoId)).data.scope.name == request.auth.token.sede ||
           get(/databases/$(database)/documents/procesos_aur/$(procesoId)).data.scope.name == request.auth.token.region)
        );
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/padron/$(carnet)).data.authUid == request.auth.uid
          && request.resource.data.voterCarnet == carnet
          && !exists(/databases/$(database)/documents/procesos_aur/$(procesoId)/votos/$(carnet))
          && (get(/databases/$(database)/documents/procesos_aur/$(procesoId)).data.scope.name == request.auth.token.sede
              || get(/databases/$(database)/documents/procesos_aur/$(procesoId)).data.scope.name == request.auth.token.region);
        allow update, delete: if false;
      }
    }
  }
}
